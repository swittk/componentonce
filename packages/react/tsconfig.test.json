{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["vitest/globals"],
    "baseUrl": ".",
    "paths": { "@componentonce/react": ["./src/index.tsx"] }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
